# ============================================================
# Aggregate to GADM0 (Country level)
# ============================================================

gadm0_aqli <- gadm2_aqli_2024 %>%
  group_by(iso_alpha3, continent, country,
           whostandard, natstandard) %>%
  summarise(
    across(
      all_of(value_cols),
      ~ round(
        sum(.x * population, na.rm = TRUE) /
          sum(population, na.rm = TRUE),
        2
      )
    ),
    population = sum(population, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(tolower(country)) %>%
  mutate(objectid_gadm0 = row_number()) %>%
  relocate(
    objectid_gadm0, iso_alpha3, continent, country,
    population, whostandard, natstandard,
    .before = 1
  )
  
  write_csv(gadm0_aqli, "~/Downloads/gadm0_aqli_pg.csv")

# ============================================================
# India-specific fix:
# Merge Dadra & Nagar Haveli with Daman & Diu
# ============================================================

# Harmonize names at GADM2
gadm2_aqli_2024 <- gadm2_aqli_2024 %>%
  mutate(
    name_1 = case_when(
      name_1 %in% c("Daman and Diu", "Dadra and Nagar Haveli") ~
        "Daman and Diu and Dadra and Nagar Haveli",
      TRUE ~ name_1
    )
  )

# Extract the two states from GADM1
gadm1_rm_daman_haveli <- gadm1_aqli %>%
  filter(objectid_gadm1 %in% c(1202, 1203)) %>%
  mutate(
    name_1 = "Daman and Diu and Dadra and Nagar Haveli"
  ) %>%
  group_by(iso_alpha3, continent, country,
           name_1, whostandard, natstandard) %>%
  summarise(
    across(
      all_of(value_cols),
      ~ round(
        sum(.x * population, na.rm = TRUE) /
          sum(population, na.rm = TRUE),
        2
      )
    ),
    population = sum(population, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(objectid_gadm1 = 1202) %>%
  relocate(
    objectid_gadm1, iso_alpha3, continent, country, name_1,
    population, whostandard, natstandard,
    .before = 1
  )

# Remove old records and bind merged state
gadm1_combined_dadar_daman <- gadm1_aqli %>%
  filter(!objectid_gadm1 %in% c(1202, 1203)) %>%
  bind_rows(gadm1_rm_daman_haveli)

# ============================================================
# Character sanitization for mapping & Highcharter
# ============================================================

gadm0_aqli$country <- stri_trans_general(gadm0_aqli$country, "Latin-ASCII")

gadm1_combined_dadar_daman <- gadm1_combined_dadar_daman %>%
  mutate(
    country = stri_trans_general(country, "Latin-ASCII"),
    name_1  = stri_trans_general(name_1,  "Latin-ASCII")
  )

gadm2_aqli_2024 <- gadm2_aqli_2024 %>%
  mutate(
    country = stri_trans_general(country, "Latin-ASCII"),
    name_1  = stri_trans_general(name_1,  "Latin-ASCII"),
    name_2  = stri_trans_general(name_2,  "Latin-ASCII")
  )

# ============================================================
# Export final datasets
# ============================================================

write_csv(
  gadm0_aqli,
  "~/Desktop/My AQLI Work/AQLI 2026/gadm0_aqli_2024_pg.csv"
)

write_csv(
  gadm1_combined_dadar_daman,
  "~/Desktop/My AQLI Work/AQLI 2026/gadm1_aqli_2024_pg.csv"
