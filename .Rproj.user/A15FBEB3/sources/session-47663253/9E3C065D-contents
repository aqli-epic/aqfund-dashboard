# ============================================================
# AQLI 2024 | GADM Aggregation Pipeline
# Purpose:
# - Clean GADM2-level AQLI data
# - Harmonize names & standards
# - Aggregate to GADM1 and GADM0 levels
# - Handle India (Dadra & Nagar Haveli, Daman & Diu) merge (objectid -1202)
# - Export clean CSVs for visualization (Highcharter / Shiny)
# ============================================================

# ----------------------------
# Load required libraries
# ----------------------------
library(dplyr)
library(readr)
library(stringr)
library(stringi)
library(htmltools)
library(highcharter)

# ----------------------------
# Read GADM2-level AQLI data
# ----------------------------
gadm2_aqli_2024 <- read_csv("~/Downloads/aqli_gadm2_2024 (1).csv")
gadm0_aqli_2023 <- read_csv("~/Desktop/India AQLI Data/AQLI Data/gadm0/gadm0_2023_wide.csv")

gadm0_aqli_t <- read_csv("~/Downloads/aqli_gadm0_2024 (1).csv")
# ----------------------------
# Country-specific national standards overrides
# ----------------------------
gadm2_aqli_2024$natstandard[gadm2_aqli_2024$country == "Senegal"] <- 25
gadm2_aqli_2024$natstandard[gadm2_aqli_2024$country == "México"]  <- 12
gadm2_aqli_2024$natstandard[gadm2_aqli_2024$country == "Pakistan"]  <- 15
gadm2_aqli_2024$natstandard[gadm2_aqli_2024$country == "China"]  <- 30

# ----------------------------
# Clean administrative names
# - Remove leading apostrophes
# ----------------------------
gadm2_aqli_2024$name_1 <- str_remove(gadm2_aqli_2024$name_1, "^'+")
gadm2_aqli_2024$name_2 <- str_remove(gadm2_aqli_2024$name_2, "^'+")

gadm2_aqli_2024$name_1 <- replace_na(gadm2_aqli_2024$name_1, "NA")
gadm2_aqli_2024$name_2 <- replace_na(gadm2_aqli_2024$name_2, "NA")
# ----------------------------
# Drop unwanted index columns
# ----------------------------
gadm2_aqli_2024 <- gadm2_aqli_2024 %>%
  select(-c("...1", "X"))

# ============================================================
# Add continent & ISO information
# ============================================================

# Extract continent–ISO mapping from GADM0 (2023)
continent_iso <- gadm0_aqli_2023 %>%
  select(objectid_gadm0, iso_alpha3, continent) %>%
  unique()

# Attach continent info to GADM0 (2024)
gadm0_aqli_2024 <- gadm0_aqli_t %>%
  left_join(continent_iso, by = "objectid_gadm0") %>%
  relocate(objectid_gadm0, iso_alpha3, continent, .before = 1)

# Create country-level lookup
continent_iso <- gadm0_aqli_2024 %>%
  select(iso_alpha3, continent, country) %>%
  distinct()

# Attach continent info to GADM2
gadm2_aqli_2024 <- gadm2_aqli_2024 %>%
  select(-continent) %>%
  left_join(continent_iso, by = "country") %>%
  relocate(objectid_gadm2, iso_alpha3, continent, .before = 1)

# ============================================================
# Aggregate to GADM1 (State/Province level)
# ============================================================

gadm2_aqli_2024 <- read_csv("~/Downloads/aqli_gadm2_2024 (2).csv")
gadm2_aqli_2024 <- gadm2_aqli_2024 %>%
  select(-c("...1"))

value_cols <- grep(
  "^(pm\\d{4}|llpp_who_\\d{4}|llpp_nat_\\d{4})$",
  names(gadm2_aqli_2024),
  value = TRUE
)

gadm1_aqli <- gadm2_aqli_2024 %>%
  group_by(iso_alpha3, continent, country, name_1,
           whostandard, natstandard) %>%
  summarise(
    across(
      all_of(value_cols),
      ~ round(
        sum(.x * population, na.rm = TRUE) /
          sum(population, na.rm = TRUE),
        2
      )
    ),
    population = sum(population, na.rm = TRUE),
    .groups = "drop"
  ) %>% 
    relocate(
      iso_alpha3, continent, country, name_1,
      population, whostandard, natstandard,
      .before = 1
    )

write_csv(gadm1_aqli,"~/Downloads/gadm1_aqli_pg.csv")
 
